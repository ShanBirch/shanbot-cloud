# Webhook Configuration for Syncing Messages from Render
# 
# Your Render webhook URL
REMOTE_WEBHOOK_BASE_URL=https://shanbot-webhook.onrender.com

# Optional: If you set WEBHOOK_ADMIN_TOKEN on Render, add it here too
# REMOTE_WEBHOOK_TOKEN=your_secret_token_here

# This is the token used to protect admin endpoints on Render
# Set the same value in your Render environment variables
# WEBHOOK_ADMIN_TOKEN=your_secret_token_here

